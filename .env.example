# Название группы в Университете Сириус
GROUP_NAME=К0609-23

# Сколько недель вперёд парсить (текущая + N)
WEEKS_AHEAD=4

# Сколько недель назад парсить
WEEKS_BEHIND=1

# Как часто обновлять расписание (в минутах)
UPDATE_INTERVAL_MINUTES=30

# Хост и порт для веб-сервера
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Часовой пояс (Сириус = Москва)
TIMEZONE=Europe/Moscow

# Уровень логирования
LOG_LEVEL=INFO

# ===== ПРОКСИ (обязательно если VPS за рубежом) =====
# schedule.siriusuniversity.ru блокирует доступ из-за рубежа.
# Нужен российский прокси/VPN.
#
# Варианты:
# 1. SOCKS5-прокси: socks5://user:pass@proxy-ru.example.com:1080
# 2. HTTP-прокси:   http://user:pass@proxy-ru.example.com:8080
# 3. Если VPS уже в России — оставить пустым
HTTP_PROXY=
HTTPS_PROXY=

# Таймаут запросов (секунды)
REQUEST_TIMEOUT=60
